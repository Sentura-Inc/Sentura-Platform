// Cross-Border Screening and Background Investigation Employee
//
// Milestone 5 of `跨境电商/DESIGN.md`.
// The global `cross-border-intel` MCP server is wired by setup scripts.
{
  agents: {
    list: [
      {
        id: "cbe-buyer-screening",
        name: "跨境筛选背调员工",
        model: "openai/gpt-5.5",
        models: {
          "openai/gpt-5.4": {
            agentRuntime: { id: "openclaw" },
          },
          "openai/gpt-5.5": {
            agentRuntime: { id: "openclaw" },
          },
        },
        runtime: { type: "embedded" },
        sandbox: { mode: "non-main" },
        tools: {
          profile: "minimal",
          alsoAllow: [
            "web_search",
            "web_fetch",
            "memory_search",
            "memory_get",
            "group:plugins",
          ],
          sandbox: {
            tools: {
              alsoAllow: [
                "web_search",
                "web_fetch",
                "memory_search",
                "memory_get",
                "cross-border-intel__*",
              ],
            },
          },
          deny: [
            "agents_list",
            "browser",
            "canvas",
            "create_goal",
            "cron",
            "exec",
            "gateway",
            "get_goal",
            "image",
            "image_generate",
            "message",
            "nodes",
            "pdf",
            "process",
            "read",
            "session_status",
            "sessions_history",
            "sessions_list",
            "sessions_send",
            "sessions_spawn",
            "sessions_yield",
            "skill_workshop",
            "subagents",
            "tts",
            "update_goal",
            "update_plan",
            "video_generate",
            "edit",
            "apply_patch",
            "write",
          ],
        },
        params: {
          role: "Cross-border mobile-accessory Screening and Background Investigation employee",
          language: "zh-CN",
          tenant: "cross-border-ecommerce",
          operationScope: "Low-cost live buyer background investigation with contextual scoring",
          executionPolicy: {
            defaultMode: "single_target_fanout",
            maxTargetsPerSession: 1,
            allowBatch3Experiment: false,
            paidEmailValidationMaxCallsPerTarget: 1,
            paidTradeSearchMaxCallsPerTarget: 1,
            paidTradeMaxSpendUsdPerTarget: 0,
            paidTradeMaxSpendUsdPerApprovedTarget: 1,
            blockBatch5Plus: true,
          },
          allowedActions: [
            "lead_batch_screening",
            "manual_input_screening",
            "public_web_research",
            "official_registry_lookup",
            "domain_email_verification",
            "sec_public_filing_lookup",
            "budget_capped_trade_record_lookup",
            "contextual_scoring",
            "risk_report_export",
          ],
          blockedActions: [
            "automatic_outreach",
            "login_gated_social_scraping",
            "protected_marketplace_scraping",
            "crm_write",
            "external_message_send",
            "secret_collection",
            "uncapped_paid_lookup",
          ],
        },
      },
    ],
  },

  bindings: [
    {
      agentId: "cbe-buyer-screening",
      match: { channel: "webchat", peer: { kind: "dm", id: "*" } },
    },
  ],
}
