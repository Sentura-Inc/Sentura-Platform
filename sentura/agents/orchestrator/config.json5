// Sentura Orchestrator Agent ("Conductor") — Agent Configuration
//
// This config is applied by scripts/sentura-setup.sh during platform setup.
// The Orchestrator coordinates multi-agent tasks across AI employees.
// It needs sessions_send/sessions_spawn for inter-agent communication.
{
  agents: {
    list: [
      {
        id: "orchestrator",
        name: "Conductor",
        model: "openai/gpt-4o",
        // NOTE: `skills` is a name filter, not a path glob. Omit it to load
        // every SKILL.md under `workspace/orchestrator/skills/*/`.
        runtime: { type: "embedded" },
        sandbox: { mode: "non-main" },
        tools: {
          profile: "minimal",
          alsoAllow: ["sessions_send", "sessions_spawn", "web_search"],
          // SANDBOX TOOL-POLICY FIX (Round 20, 2026-04-19). OpenClaw's non-main
          // sandbox applies a SECOND tool filter after agent-level alsoAllow.
          // Plugin tools (memory_*, update_plan, web_fetch, subagents, cron)
          // are stripped there unless re-added here. Without this block the
          // dashboard `chat.send` path hands Conductor a 6-tool toolset and it
          // cannot orchestrate reliably. See docs/SETUP.md § "Sandbox
          // tool-policy filter" and openclaw/src/agents/sandbox/constants.ts.
          sandbox: {
            tools: {
              alsoAllow: [
                "sessions_send",
                "sessions_spawn",
                "subagents",
                "web_search",
                "web_fetch",
                "memory_search",
                "memory_get",
                "update_plan",
                "cron",
              ],
            },
          },
        },
      }
    ]
  },
}
