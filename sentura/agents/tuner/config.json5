// Sentura Tuner Agent ("Refine") — Agent Configuration
//
// This config is applied by scripts/sentura-setup.sh during platform setup.
// The Tuner Agent modifies existing AI employee configurations via NL commands.
// It needs the "gateway" tool for config.patch to update agent settings.
{
  agents: {
    list: [
      {
        id: "tuner",
        name: "Refine",
        model: "openai/gpt-4o",
        // NOTE: `skills` is a name filter, not a path glob. Omit it to load
        // every SKILL.md under `workspace/tuner/skills/*/`.
        runtime: { type: "embedded" },
        sandbox: { mode: "non-main" },
        tools: {
          profile: "coding",
          // Agent-level filter runs BEFORE the sandbox-level filter. Both
          // must allow a tool for it to be reachable at runtime. Tuner needs:
          //   - gateway: config.get / config.patch (the agent-callable
          //     gateway tool's restricted action enum supports these — but
          //     does NOT support agents.files.get/set, so workspace edits
          //     route through sentura_agents_manage instead).
          //   - sentura_agents_manage: read/write target agent's workspace
          //     files (workspace-edit skill).
          //   - memory_search / memory_get: dedup + retrieval before edits.
          //   - update_plan: track multi-step tuning operations.
          //   - sessions_send / web_search / web_fetch: operator interaction.
          alsoAllow: [
            "gateway",
            "sessions_send",
            "web_search",
            "web_fetch",
            "sentura_agents_manage",
            "sentura_approval_request",
            "memory_search",
            "memory_get",
            "update_plan",
          ],
          // CROSS-WORKSPACE READ FIX (2026-05-03). The Tuner sandbox is
          // rooted at ~/.openclaw/sandboxes/agent-tuner-<hash>/ — raw
          // file tools (read/write/edit/apply_patch) reject any absolute
          // path under ~/.openclaw/workspace/<other-agent>/* with
          // "Path escapes sandbox root". Tuner's workspace-edit skill
          // already documents that ALL target-agent file I/O goes
          // through sentura_agents_manage { action: "read"|"write" }, but
          // with raw file tools still on the LLM's palette the model
          // will sometimes reach for them anyway. Deny them outright at
          // both the agent layer and the sandbox layer so the only
          // reachable workspace-mutation surface is sentura_agents_manage.
          // Same Round-10 pattern Forge uses for "fs_write" / "edit".
          deny: ["read", "write", "edit", "apply_patch"],
          // SANDBOX TOOL-POLICY FIX (Round 20, 2026-04-19). OpenClaw's non-main
          // sandbox applies a SECOND tool filter after agent-level alsoAllow.
          // Plugin tools (sentura_*, gateway, memory_*, update_plan, etc.) are
          // stripped there unless re-added here. Without this block the
          // dashboard `chat.send` path hands Refine a 7-tool toolset even
          // though CLI `openclaw agent --agent tuner` sees everything. See
          // docs/SETUP.md § "Sandbox tool-policy filter" and
          // openclaw/src/agents/sandbox/constants.ts (DEFAULT_TOOL_ALLOW/DENY).
          sandbox: {
            tools: {
              alsoAllow: [
                "gateway",
                "sessions_send",
                "web_search",
                "web_fetch",
                "sentura_agents_manage",
                "sentura_approval_request",
                "sentura_rbac_manage",
                "sentura_audit_query",
                "memory_search",
                "memory_get",
                "update_plan",
                "pdf",
                "canvas",
                "cron",
              ],
              // Mirror the agent-level deny inside the sandbox filter
              // so the LLM cannot escape the sandbox via raw file I/O.
              deny: ["read", "write", "edit", "apply_patch"],
            },
          },
        },
      }
    ]
  },
}
