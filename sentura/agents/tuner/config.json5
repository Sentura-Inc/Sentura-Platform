// Sentura Tuner Agent ("Refine") — Agent Configuration
//
// This config is applied by scripts/sentura-setup.sh during platform setup.
// The Tuner Agent modifies existing AI employee configurations via NL commands.
// It needs the "gateway" tool for config.patch to update agent settings.
{
  agents: {
    list: [
      {
        id: "tuner",
        name: "Refine",
        model: "openai/gpt-4o",
        // NOTE: `skills` is a name filter, not a path glob. Omit it to load
        // every SKILL.md under `workspace/tuner/skills/*/`.
        runtime: { type: "embedded" },
        sandbox: { mode: "non-main" },
        tools: {
          profile: "coding",
          alsoAllow: ["gateway", "sessions_send", "web_search", "web_fetch"],
        },
      }
    ]
  },
}
