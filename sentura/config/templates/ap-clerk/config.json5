// AP Clerk Role Template — Agent Configuration
// Apply via gateway tool config.patch (JSON5 merge-patch) after customizing placeholders.
//
// OpenClaw schema: agents.list is an ARRAY of entries with `id` field.
// No `workspace` field — OpenClaw defaults to ~/.openclaw/workspace/{agent-id}
// No `systemPrompt` — identity comes from workspace SOUL.md and AGENTS.md
// Bindings and MCP servers are top-level config, not inside the agent entry.
//
// The Creator Agent applies this as a config.patch merge during incubation.
{
  agents: {
    list: [
      {
        id: "{agent-id}",
        name: "{agent-name}",
        model: "openai/gpt-4o",
        runtime: { type: "embedded" },
        sandbox: { mode: "non-main" },
        tools: {
          profile: "minimal",
          alsoAllow: ["web_search", "web_fetch", "pdf", "canvas", "cron", "message"],
          deny: ["exec", "gateway", "browser"],
        },
      }
    ]
  },

  // Bindings are top-level — route channel messages to this agent
  // bindings: [
  //   {
  //     agentId: "{agent-id}",
  //     match: { channel: "slack", accountId: "{slack-workspace}", peer: { kind: "channel", id: "#accounts-payable" } }
  //   }
  // ],

  // MCP servers are top-level — shared across agents (scope via tool policies)
  // mcp: {
  //   servers: {
  //     "{erp_mcp}": {
  //       command: "node",
  //       args: ["./sentura/mcp-servers/{erp_mcp}/index.js"],
  //       env: { API_TOKEN: "${API_TOKEN}" }
  //     }
  //   }
  // },
}
