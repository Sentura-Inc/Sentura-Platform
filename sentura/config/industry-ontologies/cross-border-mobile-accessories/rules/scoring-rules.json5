// Cross-Border Mobile Accessories — Contextual Buyer Scoring
{
  schemaVersion: "1.0",
  pillar: "rules",
  domain: "cross-border-mobile-accessories.scoring",
  tenant: "cross-border-ecommerce",
  scoringModel: {
    name: "contextual_evidence_blocks_v1",
    description: "Compute one customer-facing final score from evidence quality and evidence coverage, then derive all tiers from that final score.",
    blockStatuses: [
      {
        status: "scored",
        meaning: "Evidence was checked and produced positive, negative, or neutral points.",
        inScoreDenominator: true,
        inCoverageDenominator: true,
      },
      {
        status: "not_applicable",
        meaning: "The evidence block does not apply to this target.",
        inScoreDenominator: false,
        inCoverageDenominator: false,
      },
      {
        status: "unavailable_api",
        meaning: "The evidence is relevant, but a required API/key/source is unavailable.",
        inScoreDenominator: false,
        inCoverageDenominator: true,
      },
      {
        status: "disabled_by_budget",
        meaning: "The evidence is relevant, but the operator did not enable a paid check.",
        inScoreDenominator: false,
        inCoverageDenominator: true,
      },
      {
        status: "pending_human_input",
        meaning: "The evidence needs an operator clue, such as registry number or confirmed legal name.",
        inScoreDenominator: false,
        inCoverageDenominator: true,
      },
    ],
    formula: {
      scoreDenominator: "sum(max_points) where status == scored",
      rawScore: "sum(earned_points) where status == scored",
      qualityScore: "rawScore / scoreDenominator * 100",
      evidenceCoverage: "sum(max_points where status == scored) / sum(max_points where status != not_applicable)",
      normalizedScore: "qualityScore * 0.8 + evidenceCoverage * 100 * 0.2",
      noEvidenceRule: "If scoreDenominator is 0, return risk_tier insufficient_evidence and ask for minimum clues.",
      forcedDowngradeRule: "If forced_downgrades exists, cap normalizedScore at 59 so the final score and high/medium/low tier remain consistent.",
    },
    riskTiers: [
      { id: "trusted_candidate", minScore: 80 },
      { id: "cautious", minScore: 60, maxScore: 79.999 },
      { id: "insufficient_evidence", whenScoreDenominatorIsZero: true },
      { id: "high_risk", maxScoreExclusive: 60 },
    ],
  },
  evidenceBlocks: [
    {
      id: "legal_identity",
      maxPoints: 20,
      applicableWhen: "company name or registry number exists",
      lowCostSources: ["Companies House", "SEC EDGAR", "official registry web result", "public official page", "Google Maps physical-address evidence for small local/offline targets"],
    },
    {
      id: "domain_email",
      maxPoints: 20,
      applicableWhen: "domain, website, or email exists or can be discovered",
      lowCostSources: ["DNS MX", "DNS SPF", "DNS DMARC", "RDAP", "email syntax", "free-provider flag", "disposable-domain list"],
    },
    {
      id: "public_footprint",
      maxPoints: 15,
      applicableWhen: "website, social/profile URL, or public search result exists",
      lowCostSources: ["web_search", "web_fetch", "public LinkedIn company result", "public Facebook/Instagram/YouTube snippets"],
    },
    {
      id: "business_fit",
      maxPoints: 20,
      applicableWhen: "product interest or discovered product/category evidence exists",
      lowCostSources: ["website categories", "search snippets", "lead matched products"],
    },
    {
      id: "trade_financial",
      maxPoints: 10,
      applicableWhen: "country/source supports an affordable check or operator enables paid data",
      lowCostSources: ["ImportYeti public search", "Volza capped paid lookup", "SEC filing", "annual report", "registry filing history"],
      defaultUnavailableStatus: "disabled_by_budget",
    },
    {
      id: "legal_disputes",
      maxPoints: 15,
      applicableWhen: "company legal name, registry id, domain, country, or location is enough to search public legal sources",
      lowCostSources: ["official court search", "official case-law search", "official insolvency notices", "regulatory enforcement pages", "public legal databases", "bounded web search"],
    },
  ],
  forcedDowngrades: [
    {
      id: "no_registry_and_young_domain",
      rule: "Company name cannot be matched to any registry or stable official source, and website/domain is younger than 90 days.",
    },
    {
      id: "free_or_disposable_email_only",
      rule: "Contact uses only disposable/free email and no business domain can be verified.",
    },
    {
      id: "legal_name_mismatch",
      rule: "Website claims a different company/legal name than registry and no explanation is found.",
    },
    {
      id: "trade_contradiction",
      rule: "Customs/trade evidence contradicts claimed country or product category in a material way.",
    },
    {
      id: "credible_fraud_sources",
      rule: "Public sources show fraud/scam accusations from credible official or repeated independent sources.",
    },
    {
      id: "material_legal_dispute_or_enforcement",
      rule: "Official court, insolvency, bankruptcy, regulator, sanctions, or repeated public legal-source evidence exact-matches the target and shows a recent or material seller-risk event.",
    },
  ],
  provenance: {
    source: "跨境电商/DESIGN.md Milestone 2",
    ingested: "2026-06-08T00:00:00Z",
    ingestedBy: "codex",
    confidence: 0.91,
  },
}
