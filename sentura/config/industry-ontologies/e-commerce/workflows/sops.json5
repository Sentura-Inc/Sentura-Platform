// E-Commerce — Standard Operating Procedures
{
  schemaVersion: "1.0",
  pillar: "workflows",
  domain: "sops",
  entities: [
    {
      id: "entity:procedure:order-fulfillment",
      type: "procedure",
      name: "Order Fulfillment Happy Path",
      attributes: {
        ownerRole: "entity:role:fulfillment-coordinator",
        steps: [
          "1. Order placed and payment captured (or authorized).",
          "2. Run fraud screening; hold if risk score above threshold.",
          "3. Allocate inventory at the closest fulfillment center with stock.",
          "4. Generate pick/pack task before {fulfillment_cutoff} in {warehouse_timezone}.",
          "5. Print shipping label; scan package before tote/bin.",
          "6. Courier pickup; tracking number pushed to OMS.",
          "7. Send shipping confirmation to customer.",
          "8. Deliver-confirmation webhook → trigger review request flow.",
        ],
      },
    },
    {
      id: "entity:procedure:rma-return",
      type: "procedure",
      name: "Return Merchandise Authorization (RMA)",
      attributes: {
        ownerRole: "entity:role:returns-specialist",
        steps: [
          "1. Verify order is within {return_window_days} days.",
          "2. Check product category eligibility (final-sale items excluded).",
          "3. Generate RMA number and prepaid return label (if policy covers).",
          "4. Customer ships; warehouse receives and inspects.",
          "5. Grade condition (A: resalable / B: open-box / C: damaged — destroy).",
          "6. Restock or dispose per grade.",
          "7. Trigger refund workflow (see procedure:refund-issuance).",
          "8. Close RMA and notify customer.",
        ],
      },
    },
    {
      id: "entity:procedure:refund-issuance",
      type: "procedure",
      name: "Refund Issuance",
      attributes: {
        ownerRole: "entity:role:cx-tier1",
        steps: [
          "1. Verify original order is eligible (not already fully refunded).",
          "2. If amount ≤ {max_auto_refund} → auto-process on original payment method.",
          "3. If amount > {max_auto_refund} → route to CX Lead for approval.",
          "4. Trigger refund through payment processor API.",
          "5. Wait for confirmation; retry on transient failures (max 3 attempts).",
          "6. Update order GL; post adjustment to ERP.",
          "7. Notify customer with timeline (1-3 business days for card, longer for bank transfer).",
          "8. Log to audit trail with reason code.",
        ],
      },
    },
    {
      id: "entity:procedure:chargeback-response",
      type: "procedure",
      name: "Chargeback / Dispute Response",
      attributes: {
        ownerRole: "entity:role:trust-safety",
        steps: [
          "1. Receive chargeback notification from processor (webhook or email).",
          "2. Pull order history, fulfillment/delivery confirmations, customer communication.",
          "3. Classify reason code (fraud, not-received, not-as-described, subscription).",
          "4. Assemble compelling evidence package per Visa/MC/Amex guidelines.",
          "5. Submit rebuttal via processor dashboard within 7 business days (internal SLA).",
          "6. Track outcome (won/lost) for fraud-model feedback and reporting.",
          "7. If customer returns after losing dispute → no additional refund (NEVER double-refund).",
        ],
      },
    },
    {
      id: "entity:procedure:product-catalog-update",
      type: "procedure",
      name: "Product Catalog Update",
      attributes: {
        ownerRole: "entity:role:merchandiser",
        steps: [
          "1. Ingest updates from PIM (SKU, title, description, attributes, imagery).",
          "2. Validate required fields, image specs, MAP pricing compliance.",
          "3. Translate / localize if multi-market.",
          "4. Sync to storefront, marketplaces, ad platforms (Google Merchant Center, Meta Catalog).",
          "5. Verify propagation in staging before going live.",
          "6. Monitor for feed errors / disapprovals in first 24h.",
        ],
      },
    },
  ],
  relations: [],
  provenance: {
    source: "industry-ontology:e-commerce",
    ingested: "2026-04-16T00:00:00Z",
    ingestedBy: "creator",
    confidence: 0.9,
  },
}
